<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <AssemblyName>worddiff-demo</AssemblyName>
    <RootNamespace>WordDiffDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenXmlPowerTools-Net6" Version="4.6.25" />
    <PackageReference Include="ScratchPad.NPOI.HWPF" Version="2.5.7" />
  </ItemGroup>
</Project>
